# Development Environment Configuration
# Used with docker-compose for local development

# Environment
NODE_ENV=development
VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=3000

# Database (MongoDB) - matches docker-compose service name
DATABASE_USER=dev_user
DATABASE_PASSWORD=dev_password
DATABASE_HOST=db-user
DATABASE_PORT=27017
DATABASE_NAME=api_user

# Security
ENCRYPTION_PASSWORD=dev_encryption_password_32_chars_min

# Development
DEBUG=true
