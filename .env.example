# Application Configuration
# Copy this file to .env and fill in your values

# ===================
# Required Variables
# ===================

# Environment (local, development, test, qa, production)
NODE_ENV=development

# Application version
VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=3000

# ===================
# Database (MongoDB)
# ===================

DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_NAME=api_user

# ===================
# Security
# ===================

# Encryption password (min 32 characters)
ENCRYPTION_PASSWORD=your_encryption_password_min_32_chars

# ===================
# Microservices (Optional)
# ===================

# Example Microservice
# EXAMPLE_MICROSERVICE_ENABLED=false
# EXAMPLE_MICROSERVICE_HOST=localhost
# EXAMPLE_MICROSERVICE_PORT=3001

# ===================
# Development
# ===================

# Enable debug mode (true/false)
# DEBUG=true
