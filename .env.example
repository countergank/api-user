# Application Configuration
# Copy this file to .env and fill in your values

# ===================
# Required Variables
# ===================

# Environment (local, development, test, qa, production)
NODE_ENV=development

# Application version
VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=3000

# ===================
# Database (MongoDB)
# ===================

DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_NAME=api_user

# ===================
# Security
# ===================

# Encryption password (min 32 characters)
ENCRYPTION_PASSWORD=your_encryption_password_min_32_chars

# ===================
# Microservices (Optional)
# ===================

# Example Microservice
# EXAMPLE_MICROSERVICE_ENABLED=false
# EXAMPLE_MICROSERVICE_HOST=localhost
# EXAMPLE_MICROSERVICE_PORT=3001

# ===================
# Email Configuration
# ===================

# Enable/disable email service (true/false)
# EMAIL_ENABLED=true

# Email provider (smtp | resend)
# EMAIL_PROVIDER=smtp

# SMTP Configuration (required when EMAIL_PROVIDER=smtp)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=your_email@gmail.com

# Resend Configuration (required when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_FROM_NAME=YourApp

# Frontend URL (used for generating links in emails)
# FRONTEND_URL=http://localhost:5173

# ===================
# Rate Limiting & Account Lockout
# ===================
# All values are optional (defaults shown)

# Global throttle defaults (used as fallback for endpoints without specific limits)
# THROTTLE_TTL=60           # Time window in seconds
# THROTTLE_LIMIT=10          # Max requests per TTL window

# Per-endpoint throttle limits
# LOGIN_THROTTLE_TTL=60      # Stricter: brute-force vector
# LOGIN_THROTTLE_LIMIT=5
# REGISTER_THROTTLE_TTL=60   # Moderate: registration endpoint
# REGISTER_THROTTLE_LIMIT=10
# FORGOT_PASSWORD_THROTTLE_TTL=60  # Stricter: email enumeration vector
# FORGOT_PASSWORD_THROTTLE_LIMIT=3

# Account lockout after failed login attempts
# MAX_LOGIN_ATTEMPTS=5       # Failed attempts before lockout
# LOCKOUT_DURATION_MINUTES=15 # Lockout duration in minutes

# Token expiration (in hours)
# ACTIVATION_TOKEN_EXPIRATION_HOURS=24
# PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# ===================
# Development
# ===================

# Enable debug mode (true/false)
# DEBUG=true

# ===================
# Redis (Optional)
# ===================
# All values are optional (defaults shown)

# Redis host (default: localhost)
# REDIS_HOST=localhost

# Redis port (default: 6379)
# REDIS_PORT=6379

# Redis password (optional, no default)
# REDIS_PASSWORD=

# Redis database number (default: 0)
# REDIS_DB=0
