{
  "name": "api-user",
  "version": "1.0.0",
  "description": "API REST User Management",
  "author": "Leandro Javier Cepeda",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "npx biome format --fix ./src",
    "lint": "npx biome lint --diagnostic-level=error ./src",
    "lint:fix": "npx biome lint --fix ./src",
    "test": "jest --forceExit --maxWorkers=50% --detectOpenHandles",
    "test:unit": "jest --forceExit --maxWorkers=50% --detectOpenHandles --testPathPattern=\\.spec\\.ts$",
    "test:e2e": "jest --detectOpenHandles --config ./test/jest-e2e.json --forceExit --collectCoverage=false",
    "test:watch": "jest --watch",
    "test:cov": "jest --detectOpenHandles --coverage --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky",
    "db:drop": "docker exec db-user mongosh --quiet --eval 'db.getSiblingDB(\"api_user\").dropDatabase()'",
    "seed:permissions": "docker compose exec api-user npx ts-node src/database/seeds/seed-permissions.ts",
    "seed:roles": "docker compose exec api-user npx ts-node src/database/seeds/seed-roles.ts",
    "seed:users": "docker compose exec api-user npx ts-node src/database/seeds/seed-users.ts",
    "seed:email-templates": "docker compose exec api-user npx ts-node src/database/seeds/seed-email-templates.ts",
    "seed:all": "npm run seed:permissions && npm run seed:roles && npm run seed:users && npm run seed:email-templates"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@fastify/compress": "^7.0.3",
    "@fastify/helmet": "^11.1.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^10.3.10",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/platform-fastify": "^10.3.10",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.2.0",
    "@types/passport-local": "^1.0.38",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "hyperid": "^3.2.0",
    "ioredis": "^5.11.1",
    "mongodb": "^6.8.0",
    "mongodb-memory-server": "^10.0.0",
    "mongoose": "^8.5.1",
    "nestjs-cls": "^6.2.0",
    "nestjs-i18n": "^10.8.3",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "migrate-mongo": "^14.0.7",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "setupFiles": [
      "<rootDir>/../test/jest.setup.ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.{!(module),}.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.mock.ts",
      "!**/main.ts",
      "!**/database/seeds/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 55,
        "branches": 45,
        "functions": 35,
        "lines": 55
      }
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
