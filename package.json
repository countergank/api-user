{
  "name": "api-user",
  "version": "1.0.0",
  "description": "API REST User Management",
  "author": "Leandro Javier Cepeda",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "npx biome format --fix ./src",
    "lint": "npx biome lint --diagnostic-level=error ./src",
    "lint:fix": "npx biome lint --fix ./src",
    "test": "jest --forceExit --maxWorkers=50% --detectOpenHandles --collectCoverage=false --lastCommit",
    "test:watch": "jest --watch",
    "test:cov": "jest --detectOpenHandles --coverage --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --detectOpenHandles --config ./test/jest-e2e.json --forceExit --collectCoverage=false",
    "prepare": "husky install"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@fastify/compress": "^7.0.3",
    "@fastify/helmet": "^11.1.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/microservices": "^10.3.10",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/platform-fastify": "^10.3.10",
    "@nestjs/swagger": "^7.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "hyperid": "^3.2.0",
    "mongodb": "^6.8.0",
    "mongodb-memory-server": "^10.0.0",
    "mongoose": "^8.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.{!(module),}.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
