# Production Environment Configuration Template
# Copy this file to .env and fill in your production values
# Usage with Docker: docker run --env-file .env ghcr.io/countergank/api-user:latest

# ===================
# Required Variables
# ===================

# Environment (set to production for production deployments)
NODE_ENV=production

# Application version (auto-populated by CI/CD)
VERSION=

# Server
HOST=0.0.0.0
PORT=3000

# ===================
# Database (MongoDB)
# ===================
# ⚠️ REPLACE WITH REAL PRODUCTION VALUES

DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=27017
DATABASE_NAME=api_user

# ===================
# Security
# ===================
# ⚠️ REPLACE WITH SECURE VALUES (min 32 characters)

ENCRYPTION_PASSWORD=

# ===================
# Microservices (Optional)
# ===================

# EXAMPLE_MICROSERVICE_ENABLED=false
# EXAMPLE_MICROSERVICE_HOST=localhost
# EXAMPLE_MICROSERVICE_PORT=3001

# ===================
# Production
# ===================

# DEBUG=false
