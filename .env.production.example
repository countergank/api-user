# Production Environment Configuration Template
# Copy this file to .env and fill in your production values
# Usage with Docker: docker run --env-file .env ghcr.io/countergank/api-user:latest

# ===================
# Required Variables
# ===================

# Environment (set to production for production deployments)
NODE_ENV=production

# Application version (auto-populated by CI/CD)
VERSION=

# Server
HOST=0.0.0.0
PORT=3000

# ===================
# Database (MongoDB)
# ===================
# ⚠️ REPLACE WITH REAL PRODUCTION VALUES

DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=27017
DATABASE_NAME=api_user

# ===================
# Security
# ===================
# ⚠️ REPLACE WITH SECURE VALUES (min 32 characters)

# JWT secret for signing tokens (REQUIRED - generate a strong random string)
JWT_SECRET=

# CORS allowed origins (REQUIRED - comma-separated list, wildcard * is rejected)
# Example: https://app.your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=

ENCRYPTION_PASSWORD=

# ===================
# Audit & Logging
# ===================

# AUDIT_ENABLED=true
# AUDIT_RETENTION_DAYS=30
# AUDIT_LEVEL=standard
# LOG_LEVEL=info

# ===================
# Rate Limiting & Account Lockout
# ===================
# All values are optional (defaults shown)
# For production, review and adjust based on expected traffic

# Global throttle defaults
# THROTTLE_TTL=60
# THROTTLE_LIMIT=10

# Per-endpoint throttle limits
# LOGIN_THROTTLE_TTL=60
# LOGIN_THROTTLE_LIMIT=5
# REGISTER_THROTTLE_TTL=60
# REGISTER_THROTTLE_LIMIT=10
# FORGOT_PASSWORD_THROTTLE_TTL=60
# FORGOT_PASSWORD_THROTTLE_LIMIT=3

# Account lockout
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15

# ===================
# Microservices (Optional)
# ===================

# EXAMPLE_MICROSERVICE_ENABLED=false
# EXAMPLE_MICROSERVICE_HOST=localhost
# EXAMPLE_MICROSERVICE_PORT=3001

# ===================
# Production
# ===================

# DEBUG=false
